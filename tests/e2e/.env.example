# Sample environment file for SeaTable e2e harness.
#
# Copy this to `.env` at the repo root (NOT inside tests/e2e/) and fill in
# real values. The harness loads them via tests/e2e/load-env.mjs.
#
# .env is gitignored — never commit a populated copy.

# SeaTable Cloud / self-hosted server URL (no trailing slash). Default
# is the public cloud.
SEATABLE_SERVER_URL=https://cloud.seatable.io

# Base-specific API Token (Read-Write). Create via Base → Advanced
# settings → API Tokens. Each base has its own token; this scopes the
# e2e harness to a single base.
SEATABLE_API_TOKEN=__paste_your_api_token_here__

# The table to write/read against. Defaults to '0000' which is the
# first table in a fresh base. Look it up under "More operations →
# Manage tables" if your base has multiple tables.
SEATABLE_TABLE_ID=0000

# Optional: a view id to scope reads. Leave empty to read every row.
SEATABLE_VIEW_ID=

# Optional: where to drop the per-config sync folder inside the test
# vault. Defaults to "SeaTable-E2E".
SEATABLE_FOLDER_PATH=SeaTable-E2E


# ── Airtable e2e (run-e2e.mjs) ──────────────────────────────────────
#
# The harness reuses the PAT from your plugin's first existing credential
# at runtime (so you don't need to copy it here). Only the e2e base/table
# identifiers are required. The PAT MUST have schema.bases:write so the
# harness can ensureFields auto-add Name/Count/Status/Cal/Description/
# DueDate/Done if they don't already exist on the target table.

# Base + table the harness should write to. Use a throw-away "Demo" or
# similar table — the harness adds permanent columns to whatever table
# you point at, and DELETE field is intentionally not used (manual
# cleanup if needed).
AIRTABLE_E2E_BASE_ID=
AIRTABLE_E2E_TABLE_ID=

# Folder inside the test vault that the e2e config syncs into.
AIRTABLE_E2E_FOLDER_PATH=Airtable-E2E


# ── Notion e2e (run-notion-e2e.mjs / run-notion-settings-e2e.mjs) ───
#
# Internal integration token — create one at notion.so/my-integrations,
# then share the target data source's parent database with it (••• menu
# → Connections → your integration).
NOTION_TOKEN=ntn_xxx

# Data source id (2025-09-03 API — a database can have multiple data
# sources; the sync config keys off the data source, not the database).
# Requires a data source with this schema: Name (title) / Notes
# (rich_text) / Score (number) / Category (select) / Tags (multi_select)
# / Due (date) / Done (checkbox) / Link (url) / Doubled (formula =
# Score * 2).
NOTION_DATA_SOURCE_ID=

# Optional: the parent database id, for display purposes only.
NOTION_DATABASE_ID=

# Optional: where to drop the per-config sync folder inside the test
# vault. Defaults to "NotionE2E".
NOTION_FOLDER_PATH=NotionE2E
